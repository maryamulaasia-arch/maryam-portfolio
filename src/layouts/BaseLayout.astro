---
// BaseLayout: the shared HTML shell every page uses.
// It sets up <head> (title, viewport) and loads the global styles/tokens/fonts.
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/interactions.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Maryamul Aasia — Product / UI UX Designer' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <slot />
    <!-- Progressive enhancement shared by current and future portfolio pages. -->
    <script>
      import '../scripts/site-interactions.js';
    </script>
  </body>
</html>
